# Next.js brauzer üçün NEXT_PUBLIC_ prefix lazımdır (Phase 2 auth)

# Phase 1-də veb auth aktiv deyil — bu dəyişənlər optional-dır.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here



# Optional: Cloudflare Turnstile (create-listing CAPTCHA)

# When omitted, listing creation works without CAPTCHA.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

TURNSTILE_SECRET_KEY=

