# Next.js brauzer üçün NEXT_PUBLIC_ prefix lazımdır

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional: Cloudflare Turnstile (create-listing CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Deep link (Android əvvəl; iOS hazırda lazım deyil) ───────────────────────
#
# Addım 0 — indi (env boş):
#   • Paylaşım: https://marketx.az/listings/{slug}
#   • Android Chrome-da elan səhifəsində "Tətbiqdə aç" (SHA-256 olmadan da işləyir)
#
# Addım 1 — App Link avtomatik açılması (Android telefon + quraşdırılmış app):
#   1. Play Console → Setup → App signing → SHA-256 certificate fingerprint
#   2. Vercel env (deploy sonrası assetlinks.json dolu olmalıdır):
# MARKETX_ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
# MARKETX_ANDROID_PACKAGE_NAME=com.hikmetaziz.marktx
#   3. Yoxlama: https://marketx.az/.well-known/assetlinks.json
#
# Addım 2 — iOS (gələcək, indi skip):
# MARKETX_IOS_APP_IDS=TEAM_ID.com.hikmetaziz.marktx
#
# Optional: telefonla LAN üzərindən dev test (HMR cross-origin warning):
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.71
